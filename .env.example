# Todos los valores tienen un default en docker-compose.yml, así que
# `docker compose up --build` funciona sin tocar nada.
#
# Para personalizar: editá los valores de este archivo y copialo:
#   cp .env.example .env
# Docker Compose lee `.env` automáticamente. `.env` está en .gitignore:
# NUNCA lo subas al repositorio.

# ---------- Compose / imagen ----------
COMPOSE_PROJECT_NAME=ecommerce-api
APP_IMAGE=ecommerce-api
APP_TAG=latest
JAVA_VERSION=21
POSTGRES_VERSION=16

# ---------- Aplicación ----------
# Puerto interno de la app y puerto publicado en el host
SERVER_PORT=8080
APP_PORT=8080
# Opciones de la JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# ---------- Base de datos ----------
DB_NAME=ecommerce
DB_USER=user
DB_PASSWORD=secret
# Puerto/interfaz publicados en el host (127.0.0.1 = solo local)
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1
# Estrategia de Hibernate: update | validate | none (usá validate/none en producción)
DDL_AUTO=update
SHOW_SQL=false

# ---------- Seguridad ----------
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=my-secret-key-for-jwt-token-signing-32-chars
JWT_EXPIRATION_HOURS=24

# ---------- Usuario admin inicial ----------
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=admin123
